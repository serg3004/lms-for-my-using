# Docker Compose production environment
# Copy this file to infra/docker/.env and fill in real values.
# Never commit the .env file.

# ── PostgreSQL ────────────────────────────────────────────────────────────────

POSTGRES_DB=lms
POSTGRES_USER=lms_user
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── API ───────────────────────────────────────────────────────────────────────

# Must match the postgres service credentials above.
DATABASE_URL=postgresql://lms_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/lms

# Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_32

# Public URL where the web container is reachable (for API CORS).
# Use your domain if running behind a reverse proxy, or http://localhost for local testing.
FRONTEND_URL=http://localhost

# Required. Prometheus/monitoring sends `Authorization: Bearer <value>` to /api/v1/metrics.
# Generate with: openssl rand -hex 32
METRICS_BEARER_TOKEN=CHANGE_ME_USE_openssl_rand_hex_32

# Optional. This compose stack runs a single API instance, so the API defaults to
# in-memory rate limiting (ALLOW_IN_MEMORY_RATE_LIMIT=true in docker-compose.prod.yml)
# when REDIS_URL is unset — no extra service required for a basic deployment.
# Uncomment and point at a Redis instance for distributed, restart-safe rate limiting
# (recommended if you run more than one API replica behind a load balancer).
# REDIS_URL=redis://redis:6379

# Optional. Set to enable Sentry error tracking.
# SENTRY_DSN=https://YOUR_KEY@oXXXXX.ingest.sentry.io/XXXXXXX

# Optional. Default: info. Options: fatal | error | warn | info | debug | trace
# LOG_LEVEL=info

# ── Web ───────────────────────────────────────────────────────────────────────

# Host port to bind the web/nginx container.
WEB_PORT=80

# ── Storage (S3-compatible) ───────────────────────────────────────────────────
# Optional. Leave blank to disable file uploads.
# For local dev with MinIO: S3_ENDPOINT=http://minio:9000, S3_FORCE_PATH_STYLE=true

# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=lms-local
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true
# MALWARE_SCANNER_URL=http://malware-scanner:8080/v1/scans
# MALWARE_SCANNER_CALLBACK_SECRET=replace-with-a-long-random-secret

# S3_REGION, S3_FILE_ORIGIN, S3_PRESIGNED_TTL_SECONDS and S3_ORPHAN_RETENTION_DAYS
# are NOT read from this .env file — docker-compose.prod.yml does not pass them
# through (see the comment there). Edit docker-compose.prod.yml directly if you
# need non-default values for those.

# ── Password reset delivery ───────────────────────────────────────────────────
# Optional. Without it, password reset requests still return the generic
# anti-enumeration response, but no reset email is actually delivered — see
# docs/contracts/PASSWORD_RESET_STATUS.md.

# HTTPS webhook that receives { email, organizationId, token, expiresAt } and
# owns turning that into an actual email. The raw token is never logged.
# PASSWORD_RESET_DELIVERY_URL=https://YOUR_DELIVERY_PROVIDER/webhooks/password-reset
# Optional. Sent as `Authorization: Bearer <value>` to the delivery webhook above.
# PASSWORD_RESET_DELIVERY_TOKEN=replace-with-a-long-random-secret
