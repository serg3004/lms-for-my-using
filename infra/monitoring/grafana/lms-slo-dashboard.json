{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Availability (5m)",
      "description": "Successful server responses divided by all requests for each SLO journey.",
      "targets": [
        { "refId": "A", "expr": "1 - lms:slo_error_ratio:rate5m", "legendFormat": "{{slo}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0.99, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "p95 latency (5m)",
      "targets": [
        { "refId": "A", "expr": "lms:slo_latency:p95_5m", "legendFormat": "{{slo}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Error-budget burn rate",
      "description": "1.0 means spending budget at exactly the sustainable 30-day rate.",
      "targets": [
        { "refId": "A", "expr": "lms:slo_error_ratio:rate5m{slo=~\"login|learner_read\"} / 0.001", "legendFormat": "{{slo}}" },
        { "refId": "B", "expr": "lms:slo_error_ratio:rate5m{slo=\"assessment_submit\"} / 0.005", "legendFormat": "{{slo}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 14.4 }] } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Journey request rate",
      "targets": [
        { "refId": "A", "expr": "lms:slo_requests:rate5m", "legendFormat": "{{slo}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["lms", "slo"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "LMS service-level objectives",
  "uid": "lms-slo",
  "version": 1
}
