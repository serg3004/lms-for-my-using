{
  "name": "@lms/shared",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    "./longread-media": {
      "types": "./src/longread-media.ts",
      "development": "./src/longread-media.ts",
      "import": "./dist/longread-media.js"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./types/api": {
      "types": "./src/types/api.ts",
      "import": "./dist/types/api.js"
    },
    "./constants/roles": {
      "types": "./src/constants/roles.ts",
      "import": "./dist/constants/roles.js"
    },
    "./assessment-question-types": {
      "types": "./src/assessment-question-types.ts",
      "development": "./src/assessment-question-types.ts",
      "import": "./dist/assessment-question-types.js"
    },
    "./longread-exercises": {
      "types": "./src/longread-exercises.ts",
      "development": "./src/longread-exercises.ts",
      "import": "./dist/longread-exercises.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
