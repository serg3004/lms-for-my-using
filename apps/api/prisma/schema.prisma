  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance       ChecklistInstance          @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actor          User?                      @relation("ChecklistInstanceEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([instanceId, createdAt, id])
  @@index([organizationId, createdAt])
  @@map("checklist_instance_events")
}

model ChecklistItemResult {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  instanceId     String                @map("instance_id") @db.Uuid
  itemId         String                @map("item_id") @db.Uuid
  checked        Boolean               @default(false)
  scaleLevel     Int?                  @map("scale_level")
  points         Int                   @default(0)
  photoUrl       String?               @map("photo_url")
  photoObjectKey String?               @map("photo_object_key")
  photoFileName  String?               @map("photo_file_name")
  photoMimeType  String?               @map("photo_mime_type")
  photoSizeBytes Int?                  @map("photo_size_bytes")
  comment        String?
