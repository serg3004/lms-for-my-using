  reviewer       User?                 @relation("ChecklistItemResultReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([instanceId, itemId])
  @@index([organizationId])
  @@index([instanceId])
  @@index([itemId])
  @@map("checklist_item_results")
}

model Membership {
