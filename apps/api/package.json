{
  "name": "@lms/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --passWithNoTests",
    "test:integration:db": "NODE_ENV=test JWT_SECRET=database-smoke-jwt-secret-32-characters NODE_OPTIONS=--experimental-vm-modules jest --config jest.database.config.cjs --runInBand",
    "smoke:mvp": "node dist/scripts/smoke-test.js",
    "admin:demo-seed": "node dist/scripts/admin-demo-seed.js",
    "storage:cleanup": "node dist/scripts/material-storage-cleanup.js",
    "storage:multipart-cleanup": "node dist/scripts/multipart-upload-cleanup.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@lms/shared": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/client": "^6.1.0",
    "@sentry/node": "^10.68.0",
    "ioredis": "^5.6.0",
    "jose": "^6.2.4",
    "multer": "^2.2.0",
    "nestjs-pino": "^4.6.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.5",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
