{
  "name": "@lms/api",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\" && pnpm architecture:check",
    "architecture:check": "node scripts/check-module-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --passWithNoTests && node scripts/check-critical-coverage.mjs",
    "test:coverage:critical": "node --test scripts/check-critical-coverage.test.mjs",
    "test:integration:db": "NODE_ENV=test JWT_SECRET=database-smoke-jwt-secret-32-characters NODE_OPTIONS=--experimental-vm-modules jest --config jest.database.config.cjs --runInBand",
    "smoke:mvp": "node dist/scripts/smoke-test.js",
    "admin:demo-seed": "node dist/scripts/admin-demo-seed.js",
    "storage:cleanup": "node dist/scripts/material-storage-cleanup.js",
    "storage:multipart-cleanup": "node dist/scripts/multipart-upload-cleanup.js",
    "session:cleanup": "node dist/scripts/session-cleanup.js",
    "positions:legacy-inventory": "node dist/scripts/positions-legacy-inventory.js",
    "positions:migrate-legacy": "node dist/scripts/migrate-legacy-positions.js",
    "jobs:worker": "BACKGROUND_JOBS_RUN_WORKER=true node dist/scripts/background-worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@lms/shared": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^6.1.0",
    "@sentry/node": "10.71.0",
    "bullmq": "^5.58.5",
    "ioredis": "^5.6.0",
    "jose": "^6.2.10",
    "multer": "^2.2.0",
    "nestjs-pino": "^4.6.1",
    "pdfkit": "^0.20.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.1.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.5",
    "@types/pdfkit": "^0.17.5",
    "eslint": "^10.9.1",
    "jest": "^30.5.0",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
