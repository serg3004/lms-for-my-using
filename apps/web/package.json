{
  "name": "@lms/web",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm check:css-bundle",
    "check:css-bundle": "node scripts/check-css-bundle.mjs",
    "lint": "pnpm lint:code && pnpm lint:css",
    "lint:code": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:css": "stylelint \"src/styles/**/*.css\" && node scripts/check-css-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@lms/shared": "workspace:*",
    "@vitejs/plugin-react": "^6.1.0",
    "exceljs": "^4.4.0",
    "i18next": "^26.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "stylelint": "^16.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
