{
  "name": "lms-for-my-using",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test --config apps/e2e/playwright.config.ts",
    "test:visual": "playwright test --config apps/e2e/playwright.visual.config.ts",
    "agent:preflight": "node scripts/agent-preflight.mjs",
    "agent:preflight:test": "node --test scripts/agent-preflight.test.mjs",
    "security:waivers": "node scripts/validate-security-waivers.mjs",
    "security:artifacts:test": "node --test scripts/security-audit-artifacts.test.mjs",
    "security:hygiene": "node scripts/generate-code-hygiene-report.mjs",
    "security:branch-protection:test": "node --test scripts/configure-branch-protection.test.mjs",
    "security:branch-protection:audit": "node scripts/configure-branch-protection.mjs",
    "test:integration:db:local": "bash scripts/test-api-database.sh",
    "test:a11y": "playwright test --config apps/e2e/playwright.accessibility.config.ts",
    "test:load-baseline": "bash load-tests/baseline.test.sh",
    "test:backup-restore": "bash tests/scripts/backup-restore.test.sh",
    "migration:production:check": "bash scripts/check-production-migrations.sh",
    "migration:production:check:test": "bash scripts/check-production-migrations.test.sh",
    "compose:resources:test": "bash scripts/docker-compose-resources.test.sh",
    "release:gate": "node scripts/verify-release-gate.mjs",
    "release:gate:test": "node --test scripts/verify-release-gate.test.mjs",
    "docs:generate": "pnpm --filter @lms/shared build && pnpm --filter @lms/api build && node apps/api/dist/scripts/generate-docs.js",
    "docs:generate:check:test": "node --test scripts/check-generated-docs.test.mjs",
    "docs:generate:check": "pnpm docs:generate:check:test && node scripts/check-generated-docs.mjs",
    "docs:prototype:test": "node --test scripts/prototype-governance.test.mjs",
    "docs:impact:test": "node --test scripts/docs-impact.test.mjs && pnpm docs:generate:check && node scripts/docs-impact.mjs",
    "docs:consistency:test": "node --test scripts/docs-consistency.test.mjs && pnpm docs:prototype:test && pnpm docs:impact:test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@eslint/js": "^10.0.1",
    "globals": "^17.11.0",
    "turbo": "^2.10.11",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "tmp@<=0.2.3": ">=0.2.4",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "webpack@>=5.49.0 <=5.104.0": ">=5.104.1",
      "webpack@>=5.49.0 <5.104.0": ">=5.104.0",
      "multer@<2.1.0": ">=2.1.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "multer@<2.2.0": ">=2.2.0",
      "file-type@>=13.0.0 <21.3.1": ">=21.3.1",
      "file-type@>=20.0.0 <=21.3.1": ">=21.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "vite@<=6.4.1": ">=6.4.2",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "tmp@<0.2.6": ">=0.2.6",
      "vitest@<4.1.0": ">=4.1.0",
      "react-router": "8.3.0",
      "brace-expansion@<1.1.16": "1.1.16",
      "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
      "brace-expansion@<5.0.9": "5.0.9",
      "fast-uri@<3.1.5": ">=3.1.5",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
      "js-yaml@>=3.0.0 <3.15.1": ">=3.15.1",
      "nanoid@<3.3.17": ">=3.3.17",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "uuid@<11.1.1": ">=11.1.1",
      "deepmerge-ts@<8.0.0": ">=8.0.0"
    }
  }
}
