NODE_ENV=development

API_PORT=3000
WEB_PORT=5173
FRONTEND_URL=http://localhost:5173

# Disabled locally. Set an explicit hop count or trusted IP/CIDR list behind a proxy.
TRUST_PROXY=false

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms

# Optional locally. Required in production unless the documented emergency override is enabled.
REDIS_URL=redis://localhost:6379
BACKGROUND_JOBS_QUEUE=lms-background-jobs
BACKGROUND_JOBS_CONCURRENCY=5
BACKGROUND_JOBS_RUN_WORKER=false
OUTBOX_POLL_INTERVAL_MS=1000
RATE_LIMIT_NAMESPACE=lms-local

# Prometheus scrape auth. Required in production (minimum 32 characters).
METRICS_BEARER_TOKEN=local-prometheus-token-change-me-now
# Optional OTLP/HTTP trace collector. Tracing is disabled when omitted.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=lms-api

JWT_SECRET=change-me-change-me-change-me-32chars

S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=lms-local
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
# Provider-neutral HTTPS webhook used to deliver password reset messages.
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_TOKEN=
